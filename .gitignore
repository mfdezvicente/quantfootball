__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
