# Publish processed snapshots and their audit metadata.
!data/processed/*.parquet
!data/processed/*.audit.json

# Credentials are never versioned, regardless of their directory.
**/credentials/
*.dpapi
*.pem
*.key

# Reports and prediction archives are versioned; runtime caches are not.
